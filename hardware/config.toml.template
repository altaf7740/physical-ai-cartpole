# Copy to config.toml (`make config`) and edit for your rig.
# config.toml is git-ignored; this template is the documented reference.

[serial]
port = "/dev/ttyACM0"        # Pico USB serial
baudrate = 115200
timeout_s = 0.01             # per-reply read timeout
startup_delay_s = 2.0        # wait after opening the port (Pico may reboot)

[hardware]
encoder_cpr = 2400           # 600 PPR x 4 quadrature edges
steps_per_meter = 80000      # TB6600 at 1/16 = 3200 steps/rev, 20T GT2 pulley = 0.04 m/rev
max_step_rate = 20000        # steps/s, the TB6600 input limit (= 0.25 m/s at 1/16)
encoder_sign = 1             # flip to -1 if +theta is the opposite way to the sim
cart_sign = 1                # flip to -1 if +x is the opposite way to the sim
angle_zero = "down"          # where the pole is when counters reset: "down" or "upright"

[estimator]
velocity_alpha = 0.3         # low-pass weight on new velocity samples (1.0 = no filter)

[policy]
model_path = "models/policy.onnx"   # or models/policy.npz
backend = "auto"             # "auto" (by file extension), "onnx" or "numpy"
rate_hz = 60                 # MUST equal the training control rate: 1 / (sim.dt * decimation)
# Observation order exactly as in the training env. Isaac Lab manager-based
# Cartpole uses joint_pos_rel then joint_vel_rel = [cart_pos, pole_pos, cart_vel, pole_vel].
# The direct env (Isaac-Cartpole-Direct-v0) uses [pole_pos, pole_vel, cart_pos, cart_vel].
obs_order = ["cart_pos", "pole_pos", "cart_vel", "pole_vel"]
action_type = "velocity"     # "velocity" (m/s), "acceleration" (m/s^2) or "force" (N)
action_scale = 1.0           # the env's action scale (raw action * scale = physical units)
action_clip = 1.0            # clip the raw policy output to +/- this before scaling
force_mass_kg = 1.0          # only for action_type = "force": a = F / mass (rough)

[safety]
engage_angle_deg = 15        # policy takes over when |theta| drops below this
disengage_angle_deg = 25     # and lets go (motor stop) above this
max_cart_vel_mps = 0.4       # also capped by max_step_rate / steps_per_meter
max_missed_reads = 5         # consecutive missed Pico replies before a fault

[logging]
enabled = true
directory = "logs"           # one CSV per run

[ui]
host = "0.0.0.0"             # all interfaces: http://cartpole-pi.local:8000 from the LAN.
                             # No login — anyone on the network can drive the motor.
                             # Use "127.0.0.1" + `make ui-remote` (SSH tunnel) to lock it down.
port = 8000
push_hz = 20                 # browser update rate (samples are batched, none are dropped)
jog_timeout_s = 0.3          # jog stops unless the browser keeps repeating it (hold-to-move)
home_on_connect = true       # home on the limit switches whenever the Pico connects (the cart MOVES on UI start)
home_speed_mps = 0.08        # speed for that automatic homing
